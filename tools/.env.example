# ─────────────────────────────────────────────────────────────
#  TudásKerék – eszközök konfigurációja
#
#  Másold át `.env` néven, és töltsd ki. A `.env` NEM kerül a repóba.
#  A service role kulcs MINDEN Row Level Security szabályt megkerül –
#  soha ne tedd kliensbe, ne oszd meg, ne commitold.
# ─────────────────────────────────────────────────────────────

# Supabase projekt (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Csak szerveroldali/eszköz-használatra. Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Az anon kulcs a kliensbe (iOS Supabase.plist, web PWA config) kerül.
# Ez nyilvános, RLS védi – itt csak azért van, hogy egy helyen legyen minden.
SUPABASE_ANON_KEY=

# Claude API az AI kérdésgeneráláshoz (console.anthropic.com)
# Alternatíva: `ant auth login` – akkor ez a sor elhagyható.
ANTHROPIC_API_KEY=
